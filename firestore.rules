rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow logged-in users to read and write to the customers collection
    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }

    // Allow logged-in users to read and write to the settlements collection
    match /settlements/{settlementId} {
      allow read, write: if request.auth != null;
    }
  }
}
