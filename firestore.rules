rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to authenticated users for customers, settlements, and areas collections
    match /{collection}/{document} {
      allow read, write: if request.auth != null && (collection == 'customers' || collection == 'settlements' || collection == 'areas');
    }

    // More specific rules can be added below if needed
  }
}
